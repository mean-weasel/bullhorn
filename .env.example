# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (recommended)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Upstash Redis — rate limiting (recommended, optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth — iOS Capacitor (optional, for iOS dev only)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Push Notifications (VAPID keys) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Twitter/X API — platform publishing (optional)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn API — platform publishing (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit API — platform publishing (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
